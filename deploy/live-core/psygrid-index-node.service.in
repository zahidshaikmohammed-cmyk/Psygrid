# PSYGRID index node: NIFTY, BANKNIFTY and SENSEX 1m candles, option chains and 20-level option
# depth, RAM-only. Rendered by deploy/live-core/install.sh (MODE=index) into
# /etc/systemd/system/psygrid-index-node.service. It takes the Dhan token from the stock node.
[Unit]
Description=PSYGRID index node (NIFTY, BANKNIFTY, SENSEX: 1m candles, option chains, depth)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
Type=simple
User=@USER@
Group=@USER@
WorkingDirectory=@ROOT@/current
EnvironmentFile=-/etc/psygrid-live-core.env
EnvironmentFile=-/etc/psygrid-live-core-node.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=MALLOC_ARENA_MAX=2
ExecStart=@ROOT@/venv/bin/python -m live_core.index_node

Restart=always
RestartSec=10
RestartPreventExitStatus=2
TimeoutStopSec=30
KillSignal=SIGTERM

MemoryHigh=650M
MemoryMax=800M
TasksMax=128
LimitNOFILE=8192
OOMScoreAdjust=-500

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
