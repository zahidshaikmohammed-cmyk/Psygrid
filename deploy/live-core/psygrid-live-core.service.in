# PSYGRID Live Core node @NODE_ID@: RAM-only Dhan 1m equity feed for one partition of the 989-stock universe.
# Rendered by deploy/live-core/install.sh into /etc/systemd/system/psygrid-live-core-node@NODE_ID@.service.
# Independent of psygrid.service: neither depends on, orders after, or restarts the other.
[Unit]
Description=PSYGRID Live Core node @NODE_ID@ (RAM-only 1m equity feed)
After=network-online.target
Wants=network-online.target
# At most 10 starts in 10 minutes; then systemd stops trying instead of looping.
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
Type=simple
User=@USER@
Group=@USER@
WorkingDirectory=@ROOT@/current
# Dhan credentials (DHAN_CLIENT_ID plus DHAN_ACCESS_TOKEN or DHAN_PIN/DHAN_TOTP_SECRET); kept on the VM.
EnvironmentFile=/etc/psygrid-live-core.env
# Topology written by the deploy workflow (LIVE_CORE_PEERS, LIVE_CORE_PORT).
EnvironmentFile=-/etc/psygrid-live-core-node.env
Environment=LIVE_CORE_NODE_ID=@NODE_ID@
Environment=LIVE_CORE_NODE_COUNT=@NODE_COUNT@
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
# Fewer glibc malloc arenas: lower RSS on a 1 GB VM with a handful of threads.
Environment=MALLOC_ARENA_MAX=2
ExecStart=@ROOT@/venv/bin/python -m live_core

Restart=on-failure
RestartSec=10
RestartSteps=5
RestartMaxDelaySec=120
# Exit status 2 is a configuration error (bad node id, invalid stocks.json): do not restart-loop on it.
RestartPreventExitStatus=2
TimeoutStopSec=30
KillSignal=SIGTERM

# runtime_guard.ServiceWatchdog pings only while /health/node answers within the fd and RSS budget.
WatchdogSec=180
NotifyAccess=main

# Sized for an E2.1.Micro (1 GB RAM, 1/8 OCPU baseline).
MemoryHigh=650M
MemoryMax=800M
TasksMax=128
LimitNOFILE=8192
OOMScoreAdjust=-500

# Market data is RAM-only: the service cannot write anywhere on disk except a private /tmp.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
